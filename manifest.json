{
  "manifest_version": 3,
  "name": "双语网页翻译",
  "version": "0.1.0",
  "description": "将当前网页正文翻译为简体中文，并在原文下方显示译文。",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "双语网页翻译"
  },
  "background": {
    "service_worker": "background.js"
  }
}
